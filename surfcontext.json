{
  "version": "5.2",
  "source": "manual",
  "format": ".surf",
  "home": "local",
  "platforms": ["claude", "codex", "cursor"],
  "canonical": {
    "rootContext": "CONTEXT.surf",
    "docsDir": ".context/docs",
    "agentsDir": ".context/agents",
    "skillsDir": ".context/skills"
  },
  "generation": {
    "claude": {
      "rootContext": "CLAUDE.md",
      "method": "core-distillate",
      "rootContextMethod": "core-distillate"
    },
    "codex": {
      "rootContext": "AGENTS.md",
      "method": "core-distillate"
    },
    "cursor": {
      "rootContext": ".cursorrules",
      "method": "core-distillate"
    }
  },
  "coreInjection": {
    "budget": 2000,
    "sourceSection": "## Core",
    "stamp": true
  },
  "discoveryOrder": [
    "CONTEXT.surf",
    "surfcontext.json",
    "SPEC.surf",
    ".context/skills/",
    "content/",
    "src/"
  ]
}
