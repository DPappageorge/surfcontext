# .contamination-terms — the class patterns the commit door greps for.
#
# Format, one rule per line:
#   <label> <extended-regex>          a HIT: the line is contaminated
#   !<extended-regex>                 an ALLOW: a line matching this is never a hit
#   # ...                             comment
#
# Labels carry no spaces; everything after the first run of whitespace is the
# POSIX extended regular expression, passed to grep -E verbatim.
#
# This file ships CLASS PATTERNS ONLY. Site-specific rosters — machine
# nicknames, floor names, owner prefixes, internal project code names — are
# deliberately absent from a public repository and are supplied at run time:
#   bash contamination-gate.sh --terms /path/to/private-nicknames
# so the same gate can be pointed at a private list without that list ever
# living here.

# --- allows (evaluated first; an allowed line is never reported) -------------
# The public product endpoint and the owner's own domain are legitimate in this
# repository; without these the host classes would swallow them.
!https?://surf\.space
!(^|[^A-Za-z0-9.-])cloudsurf\.com

# --- hosts ------------------------------------------------------------------
tailnet-ip       (^|[^0-9.])100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)
local-hostname   [A-Za-z0-9][A-Za-z0-9-]*\.local([^.A-Za-z0-9-]|$)
tailnet-hostname [A-Za-z0-9][A-Za-z0-9-]*\.ts\.net\b
private-lan-ip   (^|[^0-9.])(10\.[0-9]{1,3}|192\.168)\.[0-9]{1,3}\.[0-9]{1,3}([^0-9.]|$)

# --- machine nicknames (empty by design — supply with --terms) --------------
# machine-nickname  <your-roster-here>

# --- cloud resource ids -----------------------------------------------------
aws-account-id   (^|[^0-9])[0-9]{12}([^0-9]|$)
amplify-app      amplifyapp\.com
s3-bucket        (s3://|\.s3[.-][a-z0-9-]*\.amazonaws\.com)

# --- money ------------------------------------------------------------------
# Two-or-more digits, or any decimal amount: shell positional parameters are
# single-digit and must not trip this.
price            \$[0-9]{2,}|\$[0-9]+\.[0-9]+

# --- local filesystem -------------------------------------------------------
home-path        /Users/[A-Za-z0-9._-]+
dev-volume-path  /Volumes/[A-Za-z0-9._-]+
transcript-key   -(Users|Volumes)-[A-Za-z0-9][A-Za-z0-9-]*-

# --- workspace, doc, folder and card identifiers ----------------------------
uuid             [0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}
card-id          (^|[^A-Za-z0-9])TASK-[0-9]{1,6}([^0-9]|$)

# --- third-party company names ----------------------------------------------
third-party-name (^|[^A-Za-z])(Anthropic|OpenAI|Notion|Vercel|Atlassian|Squarespace|Wix|Linear|Figma|Adobe|Microsoft|Google|Slack|Jira|Confluence|Dropbox|Airtable|Trello|Asana|Zapier|Heroku|Netlify)([^A-Za-z]|$)

# --- AI attribution ---------------------------------------------------------
ai-attribution   (Co-[Aa]uthored-[Bb]y|[Gg]enerated (with|by) (Claude|Codex|an AI|AI)|AI-generated|[Ww]ritten by (Claude|an AI)|[Pp]owered by (Anthropic|OpenAI)|🤖)

# --- secrets ----------------------------------------------------------------
secret-prefix    (^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{16,}|(^|[^A-Za-z0-9])ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}
private-key      -----BEGIN [A-Z ]*PRIVATE KEY-----
bearer-literal   [Bb]earer [A-Za-z0-9._-]{24,}
